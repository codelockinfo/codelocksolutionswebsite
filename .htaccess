RewriteEngine On

# Rewrite sitemap.xml requests internally to dynamic sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 1. Enforce HTTPS & Non-WWW dynamically (excluding local environments)
# Redirects http://, https://www. and http://www. to https://domain.tld dynamically in one step
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# 2. Redirect legacy index.php/path/to/page.php (or page) to /page
# Matches any path segment ending in one of our known pages
RewriteCond %{THE_REQUEST} \s/index\.php/(?:[^/]+/)*(about|allapps|androiddevlopment|blogdetail|blogs|career|collabs|contact|coststart|custom_web|digitalmarketing|ecommercewebsite|graphicdesign|hireexpert|pricing-blog|projects|revenue24|services|shopifyapps|shopifyplus|tranceclient|websitedevlopment)(?:\.php)?(?:\s|\?) [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Redirect all other arbitrary /index.php/ path requests to home page /
RewriteCond %{THE_REQUEST} \s/index\.php/[^\s\?]+ [NC]
RewriteRule ^ / [R=301,L]

# 4. Remove .php extension from URL internally
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# 5. Redirect direct .php requests to non-.php clean URLs
RewriteCond %{THE_REQUEST} \s/([^\.]+)\.php [NC]
RewriteRule ^ /%1 [R=301,L]

# Prevent directory listing
Options -Indexes
